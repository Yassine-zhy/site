# ============================================================================
#  Configuration du bot : copiez ce fichier en « .env » puis remplissez-le.
#  Le fichier .env contient vos clés : ne le partagez JAMAIS et ne le mettez
#  pas sur GitHub (il est déjà exclu par le .gitignore).
# ============================================================================

# --- Mode de fonctionnement --------------------------------------------------
#   paper   : vrais prix du marché, ordres SIMULÉS, aucune clé nécessaire (défaut)
#   testnet : vrais ordres sur le testnet Binance (argent fictif, clés de test)
#   live    : ARGENT RÉEL (exige aussi CONFIRM_LIVE=OUI)
MODE=paper
CONFIRM_LIVE=

# --- Exchange et clés API ----------------------------------------------------
# kraken ou binance (testnet : binance uniquement).
# Frais d'un ordre au marché : environ 0,40 % sur Kraken, 0,10 % sur Binance.
EXCHANGE=kraken
# Clé avec le droit de TRADER, jamais celui de RETIRER des fonds.
API_KEY=
API_SECRET=

# --- Marché ------------------------------------------------------------------
# Exemples : BTC/USDT, ETH/USDT, BTC/USDC, BTC/EUR
SYMBOL=BTC/USDT
# Swing trading : 4h ou 1d (des bougies plus courtes = plus d'ordres = plus de frais)
TIMEFRAME=4h
CANDLES_LIMIT=500

# --- Gestion des risques (en %) ---------------------------------------------
POSITION_SIZE_PCT=50
# Plafond d'un achat en USDT (0 = aucun). Utile sur le testnet, qui crédite
# des milliers d'USDT fictifs : MAX_ORDER_COST=50 reproduit un compte de 100 $.
MAX_ORDER_COST=0
STOP_LOSS_PCT=3
TAKE_PROFIT_PCT=8

# --- Stratégie ---------------------------------------------------------------
RSI_PERIOD=14
RSI_BUY_LEVEL=40
RSI_SELL_LEVEL=70
EMA_FAST=50
EMA_SLOW=200

# --- Rythme de la boucle (en secondes) --------------------------------------
# Analyse des bougies toutes les 15 min ; contrôle du stop-loss / take-profit
# toutes les 60 s quand une position est ouverte.
ANALYSIS_INTERVAL_SECONDS=900
PRICE_CHECK_INTERVAL_SECONDS=60

# --- Paper trading et backtest ----------------------------------------------
PAPER_START_BALANCE=100
# Mettez les frais réels de votre exchange : 0.4 pour Kraken, 0.1 pour Binance.
PAPER_FEE_PCT=0.4
PAPER_SLIPPAGE_PCT=0.05

# --- Journal -----------------------------------------------------------------
# DEBUG affiche aussi chaque contrôle de prix (toutes les 60 s).
LOG_LEVEL=INFO
