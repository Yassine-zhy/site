# ============================================================================
#  Configuration du bot : copiez ce fichier en « .env » puis remplissez-le.
#  Le fichier .env contient vos clés : ne le partagez JAMAIS et ne le mettez
#  pas sur GitHub (il est déjà exclu par le .gitignore).
# ============================================================================

# --- Mode de fonctionnement --------------------------------------------------
#   paper   : vrais prix du marché, ordres SIMULÉS, aucune clé nécessaire (défaut)
#   testnet : vrais ordres sur le testnet Binance (argent fictif, clés de test)
#   live    : ARGENT RÉEL (exige aussi CONFIRM_LIVE=OUI)
MODE=paper
CONFIRM_LIVE=

# --- Exchange / courtier et clés API ----------------------------------------
#   kraken, binance : cryptos (testnet : binance uniquement)
#   alpaca          : actions et ETF américains (Nvidia, Apple, S&P 500...)
# Frais d'un ordre au marché : environ 0,40 % sur Kraken, 0,10 % sur Binance,
# aucune commission sur Alpaca.
EXCHANGE=kraken
# Clé avec le droit de TRADER, jamais celui de RETIRER des fonds.
# Alpaca demande ses clés même en mode paper (pour lire les prix).
API_KEY=
API_SECRET=

# --- Marché ------------------------------------------------------------------
# Cryptos : BTC/USDT, ETH/USDT, SOL/USDT, BTC/USDC, BTC/EUR...
# Actions et ETF (EXCHANGE=alpaca) : NVDA, AAPL, TSLA, MSFT, SPY, QQQ...
SYMBOL=BTC/USDT
# Swing trading : 4h ou 1d (des bougies plus courtes = plus d'ordres = plus de frais).
# Pour les actions, préférez 1d.
TIMEFRAME=4h
CANDLES_LIMIT=500

# --- Gestion des risques (en %) ---------------------------------------------
POSITION_SIZE_PCT=50
# Plafond d'un achat en USDT (0 = aucun). Utile sur le testnet, qui crédite
# des milliers d'USDT fictifs : MAX_ORDER_COST=50 reproduit un compte de 100 $.
MAX_ORDER_COST=0
STOP_LOSS_PCT=3
TAKE_PROFIT_PCT=8

# --- Qui prend les décisions ? ---------------------------------------------
#   ai         : Claude analyse le marché ET l'actualité à chaque consultation
#                (payant : environ 0,10 à 0,20 $ par consultation, voir README)
#   indicators : règles fixes RSI + EMA ci-dessous (gratuit)
STRATEGY=ai

# Clé de l'API Anthropic, à créer sur https://console.anthropic.com
# (facturée à part de l'abonnement Claude). Nécessaire seulement si STRATEGY=ai.
ANTHROPIC_API_KEY=
# claude-opus-5-5 (le plus capable), claude-sonnet-5-5 (environ 2 fois moins cher),
# claude-haiku-5-5 (beaucoup moins cher, mais moins fin)
AI_MODEL=claude-opus-5-5
# Profondeur de réflexion : low, medium, high, xhigh, max (plus haut = plus cher)
AI_EFFORT=medium
# Consultation régulière (240 min = une fois par bougie 4h)...
AI_INTERVAL_MINUTES=240
# ...ou plus tôt si le prix bouge de plus de ce pourcentage depuis la dernière
AI_PRICE_TRIGGER_PCT=3
# Plafond de dépense : nombre maximal de consultations par jour
AI_MAX_CALLS_PER_DAY=12
# Une décision BUY ou SELL n'est appliquée que si la confiance de l'IA atteint ce seuil (sur 100)
AI_MIN_CONFIDENCE=60
# Recherche d'actualités sur le web (0,01 $ par recherche)
AI_WEB_SEARCH=oui
AI_MAX_SEARCHES=3

# --- Règles fixes (STRATEGY=indicators, et backtest) ------------------------
RSI_PERIOD=14
RSI_BUY_LEVEL=40
RSI_SELL_LEVEL=70
EMA_FAST=50
EMA_SLOW=200

# --- Rythme de la boucle (en secondes) --------------------------------------
# Analyse des bougies toutes les 15 min ; contrôle du stop-loss / take-profit
# toutes les 60 s quand une position est ouverte.
ANALYSIS_INTERVAL_SECONDS=900
PRICE_CHECK_INTERVAL_SECONDS=60

# --- Paper trading et backtest ----------------------------------------------
PAPER_START_BALANCE=100
# Mettez les frais réels de votre exchange : 0.4 pour Kraken, 0.1 pour Binance,
# 0.05 pour Alpaca (pas de commission, mais un petit écart d'achat/vente).
PAPER_FEE_PCT=0.4
PAPER_SLIPPAGE_PCT=0.05

# --- Actions (EXCHANGE=alpaca) ---------------------------------------------
# Source des prix : iex (gratuite) ou sip (abonnement Alpaca payant)
ALPACA_DATA_FEED=iex

# --- Journal -----------------------------------------------------------------
# DEBUG affiche aussi chaque contrôle de prix (toutes les 60 s).
LOG_LEVEL=INFO
