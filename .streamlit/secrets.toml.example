# Copie ce fichier sous le nom « secrets.toml » (dans le même dossier .streamlit/)
# puis colle tes clés entre les guillemets. Une clé vide = source désactivée.
# secrets.toml est listé dans .gitignore : il ne sera jamais publié sur GitHub.

FINNHUB_API_KEY = ""       # https://finnhub.io/register
NEWSAPI_API_KEY = ""       # https://newsapi.org/register
MARKETAUX_API_KEY = ""     # https://www.marketaux.com/register
ALPHAVANTAGE_API_KEY = ""  # https://www.alphavantage.co/support/#api-key

# IA : résumés, assistant, analyses d'entreprises, édito du brief (optionnel : sans clé, l'appli fait des
# résumés « locaux » et l'assistant cherche dans les dépêches et le glossaire). Guides 8 et 24.
GEMINI_API_KEY = ""        # https://aistudio.google.com/apikey
GROQ_API_KEY = ""          # https://console.groq.com/keys
# GEMINI_MODEL = "gemini-flash-latest"       # à changer seulement si Google retire ce nom
# GROQ_MODEL = "llama-3.3-70b-versatile"     # liste : https://console.groq.com/docs/models
# AI_DAILY_LIMIT = 30      # questions à l'IA par jour et par compte
# AI_VISITOR_LIMIT = 5     # questions à l'IA par visite pour un visiteur non connecté
# AI_PER_MINUTE = 20       # appels à l'IA par minute pour tout le site (offres gratuites : 15 à 30)

# Comptes : par défaut, chacun crée son compte par e-mail (rien à configurer, guide 22).
# LOCAL_MODE = true                     # usage personnel : une seule personne, sans connexion
# ADMIN_EMAILS = "ton.adresse@gmail.com"  # accès à la page Outils → Configuration une fois en ligne

# Base de données en ligne (optionnel : sans elle, fichier SQLite local). Indispensable sur Streamlit
# Community Cloud pour conserver les comptes. Marche à suivre : guide/20-base-de-donnees-en-ligne.md
# DATABASE_URL = "postgresql://utilisateur:mot-de-passe@serveur:5432/postgres"

# --- Comptes utilisateurs (optionnel : sans cette partie, l'appli fonctionne en « mode local ») ---
# Marche à suivre complète : guide/14-comptes-utilisateurs.md
#
# [auth]
# redirect_uri = "http://localhost:8501/oauth2callback"      # en ligne : https://ton-appli.streamlit.app/oauth2callback
# cookie_secret = "une-longue-chaine-aleatoire"              # python -c "import secrets; print(secrets.token_hex(32))"
#
# [auth.google]                                              # « Continuer avec Google »
# client_id = "xxxx.apps.googleusercontent.com"
# client_secret = "xxxx"
# server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
#
# [auth.auth0]                                               # e-mail + mot de passe, Facebook, Google…
# client_id = "xxxx"
# client_secret = "xxxx"
# server_metadata_url = "https://TON-DOMAINE.eu.auth0.com/.well-known/openid-configuration"
# client_kwargs = { "prompt" = "login" }
