# Copie ce fichier en .env.local puis remplis les valeurs (ne jamais committer .env.local).

# --- Supabase (Project Settings > API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Clé secrète : serveur uniquement (tâches planifiées). Utilisée à partir de la phase 3.
SUPABASE_SECRET_KEY=

# --- URL publique du site (liens dans les emails). En local : http://localhost:3000 ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Données de marché (phase 3) : https://finnhub.io/dashboard ---
FINNHUB_API_KEY=

# --- Secret des tâches planifiées (phase 4) : une longue chaîne aléatoire ---
CRON_SECRET=
